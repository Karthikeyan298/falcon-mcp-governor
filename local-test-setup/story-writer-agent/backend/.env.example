# --- LLM provider (pluggable: ollama, openai; other vendors later) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3

# Ollama-specific (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-specific (used when LLM_PROVIDER=openai; set LLM_MODEL to e.g. gpt-4o-mini)
# OPENAI_API_KEY=

# Placeholder for future vendors
# ANTHROPIC_API_KEY=

# --- MCP servers (HTTP transport) ---
DB_MCP_SERVER_URL=http://localhost:8001/mcp
EMAIL_MCP_SERVER_URL=http://localhost:8002/mcp
# Sent as the X-Agent-Key header on every MCP request (list_tools/call_tool)
MCP_AGENT_KEY=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:4201
