# --- LLM provider (pluggable: ollama today, other vendors later) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3

# Ollama-specific (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Placeholders for future vendors (unused while LLM_PROVIDER=ollama)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- MCP servers (HTTP transport) ---
DB_MCP_SERVER_URL=http://localhost:8001/mcp
EMAIL_MCP_SERVER_URL=http://localhost:8002/mcp
# Sent as the X-Agent-Key header on every MCP request (list_tools/call_tool)
MCP_AGENT_KEY=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:4201
