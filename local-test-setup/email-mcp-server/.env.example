# Copy this file to .env and fill in real values. .env is gitignored.

# SMTP (sending mail)
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=8085
EMAIL_SMTP_USE_TLS=false

# IMAP (reading mail)
EMAIL_IMAP_HOST=localhost
EMAIL_IMAP_PORT=8086

# Shared credentials (used for both SMTP and IMAP)
EMAIL_USER=test@example.com
EMAIL_PASSWORD=app-password-here

# MCP HTTP transport
EMAIL_MCP_HOST=0.0.0.0
EMAIL_MCP_PORT=8002
